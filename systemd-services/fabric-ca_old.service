# Service definition for Hyperledger fabric-ca server
[Unit]
Description=hyperledger fabric-ca server - Certificate Authority for hyperledger fabric
Documentation=https://hyperledger-fabric-ca.readthedocs.io/
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
Restart=on-failure
Environment=FABRIC_CA_HOME=/etc/hyperledger/fabric-ca-server
Environment=FABRIC_CA_SERVER_HOME=/etc/hyperledger/fabric-ca-server
#Environment=FABRIC_CA_SERVER_COMPATIBILITY_MODE_V1_3=true
Environment=CA_CFG_PATH=/etc/hyperledger/fabric-ca-server
#Environment=CA_CFG_PATH=$HOME/fabric/
#ExecStart=/usr/local/bin/fabric-ca-server start -b admin:adminpw 
ExecStart=/usr/local/bin/fabric-ca-server start -b admin:adminpw -d 
StandardOutput=append:/var/log/fabric-ca-server.log
StandardError=append:/var/log/fabric-ca-server.log
[Install]
WantedBy=multi-user.target

# to reload service after edit run: systemctl daemon-reload


