#!/bin/sh

# detect - det's whether buildpack should be used to build a CC package & launch it 

CHAINCODE_METADATA_DIR="$2"

set -euo pipefail

# use jq to extract the CC type from metadata.json & exit w/ success if CC type is golang
if [ "$(cat "$CHAINCODE_METADATA_DIR/metadata.json" | sed -e 's/[{}]/''/g' | awk -F"[,:}]" '{for(i=1;i<=NF;i++){if($i~/'type'\042/){print $(i+1)}}}' | tr -d '"')" = "external" ]; then
    exit 0
fi

exit 1
